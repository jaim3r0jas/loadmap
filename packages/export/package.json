{
  "name": "@loadmap/export",
  "version": "0.3.0",
  "description": "PNG, GIF, WebM and MP4 of a loadmap, recorded on a fixed clock so the same options give the same file.",
  "keywords": [
    "loadmap",
    "gif",
    "video",
    "export"
  ],
  "license": "MIT",
  "author": "Jaime Rojas",
  "homepage": "https://jaim3r0jas.github.io/loadmap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaim3r0jas/loadmap.git",
    "directory": "packages/export"
  },
  "bugs": "https://github.com/jaim3r0jas/loadmap/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@loadmap/core": "workspace:*",
    "@loadmap/react": "workspace:*",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.65.0"
  },
  "peerDependencies": {}
}
