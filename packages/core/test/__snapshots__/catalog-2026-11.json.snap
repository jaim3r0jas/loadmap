{
  "edition": "2026-11",
  "components": {
    "kafka": {
      "id": "kafka",
      "name": "Apache Kafka",
      "about": "A distributed log: brokers hold the partitions of topics.",
      "kind": "stream",
      "box": "cluster",
      "tags": [
        "Kafka",
        "streaming",
        "broker"
      ],
      "versionMatters": false,
      "conditions": {
        "brokers": {
          "label": "brokers",
          "doc": "Brokers in the cluster.",
          "unit": "brokers"
        },
        "replication": {
          "label": "replication factor",
          "doc": "Copies of each partition."
        },
        "acks": {
          "label": "acks",
          "doc": "What a producer waits for: all (every in-sync replica) or 1 (the leader)."
        },
        "messageSize": {
          "label": "message size",
          "doc": "The size of each message."
        },
        "producers": {
          "label": "producers",
          "doc": "Producers writing at once.",
          "unit": "producers"
        }
      },
      "figures": [
        {
          "id": "omb-2020",
          "measure": "capacity",
          "value": 605,
          "unit": "MB/s",
          "what": "peak throughput, produced and consumed",
          "scope": "for the whole cluster",
          "when": {
            "brokers": 3,
            "replication": 3,
            "acks": "all",
            "messageSize": "1 KB",
            "producers": 4
          },
          "conditions": [
            "brokers of 8 vCPU, 64 GB, 2 × 2.5 TB NVMe, 25 Gbps (AWS i3en.2xlarge)",
            "100 partitions, 4 producers and 4 consumers",
            "min.insync.replicas 2, batch.size 1 MB, linger.ms 10, flushing left to the OS page cache",
            "OpenMessaging Benchmark, Java 11"
          ],
          "versions": [
            "2.6"
          ],
          "source": {
            "title": "Benchmarking Apache Kafka, Apache Pulsar, and RabbitMQ: Which is the Fastest?",
            "url": "https://www.confluent.io/blog/kafka-fastest-messaging-system/",
            "by": "Confluent",
            "date": "2020-08-21",
            "checked": "2026-11-09"
          }
        },
        {
          "id": "omb-2020-latency",
          "measure": "latency",
          "value": 5,
          "unit": "ms",
          "what": "p99 latency at 200 MB/s",
          "scope": "for the whole cluster",
          "when": {
            "brokers": 3,
            "replication": 3,
            "acks": "all",
            "messageSize": "1 KB",
            "producers": 4
          },
          "conditions": [
            "brokers of 8 vCPU, 64 GB, 2 × 2.5 TB NVMe, 25 Gbps (AWS i3en.2xlarge)",
            "100 partitions, 4 producers and 4 consumers",
            "min.insync.replicas 2, batch.size 1 MB, linger.ms 10, flushing left to the OS page cache",
            "OpenMessaging Benchmark, Java 11"
          ],
          "versions": [
            "2.6"
          ],
          "source": {
            "title": "Benchmarking Apache Kafka, Apache Pulsar, and RabbitMQ: Which is the Fastest?",
            "url": "https://www.confluent.io/blog/kafka-fastest-messaging-system/",
            "by": "Confluent",
            "date": "2020-08-21",
            "checked": "2026-11-09"
          }
        },
        {
          "id": "linkedin-2014",
          "measure": "capacity",
          "value": 193,
          "unit": "MB/s",
          "what": "produce throughput, 2,024,032 records/s, asynchronous replication",
          "scope": "for the whole cluster",
          "when": {
            "brokers": 3,
            "replication": 3,
            "acks": "1",
            "messageSize": "100 B",
            "producers": 3
          },
          "conditions": [
            "brokers of 6-core Xeon 2.5 GHz, 32 GB, 6 × 7200 rpm SATA (JBOD), 1 GbE",
            "6 partitions, 50 million records, no consumers; MB/s counts the values only",
            "acks as in the commands the post links"
          ],
          "versions": [
