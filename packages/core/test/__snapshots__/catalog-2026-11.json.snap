    "rabbitmq": {
      "id": "rabbitmq",
      "name": "RabbitMQ",
      "about": "A message broker: queues and streams over AMQP.",
      "kind": "queue",
      "box": "node",
      "tags": [
        "AMQP",
        "broker",
        "queue"
      ],
      "versionMatters": true,
      "conditions": {
        "nodes": {
          "label": "nodes",
          "doc": "Nodes in the cluster.",
          "unit": "nodes"
        },
        "queueType": {
          "label": "queue type",
          "doc": "quorum, classic or stream."
        },
        "protocol": {
          "label": "protocol",
          "doc": "AMQP 1.0 or AMQP 0.9.1."
        },
        "messageSize": {
          "label": "message size",
          "doc": "The size of each message."
        },
        "flowControl": {
          "label": "flow control",
          "doc": "default, or raised (larger credits and windows)."
        }
      },
      "figures": [
        {
          "measure": "capacity",
          "unit": "msg/s",
          "what": "messages through the queue",
          "scope": "for one node",
          "conditions": [
            "one node on an Intel NUC 11 (8 cores, 32 GB), 3 Erlang schedulers (+S 3), Erlang/OTP 27.0.1",
            "the clients on the same machine, 1 million messages, measured end to end",
            "flow control raised: credit_flow_default_credit {5000, 2500}, max_incoming_window 5000, max_link_credit 2000, max_queue_credit 5000"
          ],
          "versions": [
            "4.0"
          ],
          "source": {
            "title": "AMQP 1.0 Benchmarks",
