    "valkey": {
      "id": "valkey",
      "name": "Valkey",
      "about": "An in-memory key-value store, Redis-compatible.",
      "kind": "cache",
      "box": "node",
      "tags": [
        "Redis",
        "Redis-compatible",
        "cache",
        "key-value"
      ],
      "versionMatters": true,
      "conditions": {
        "operation": {
          "label": "operation",
          "doc": "The command measured: SET or GET."
        },
        "valueSize": {
          "label": "value size",
          "doc": "The size of each value."
        },
        "ioThreads": {
          "label": "io-threads",
          "doc": "The io-threads setting: the main thread and the I/O threads."
        }
      },
      "figures": [
        {
          "id": "set-8.0",
          "measure": "capacity",
          "value": 1190000,
          "unit": "req/s",
          "what": "SET requests",
          "scope": "for one node",
          "when": {
            "operation": "SET",
            "valueSize": "512 B",
            "ioThreads": 9
          },
          "conditions": [
            "AWS c7g.4xlarge (16 Arm cores), no RDB saves, the main thread pinned",
            "valkey-benchmark -t set -d 512 -r 3000000 -c 650 --threads 50, from another instance"
          ],
          "versions": [
            "8.0"
          ],
          "source": {
            "title": "Unlock 1 Million RPS: Experience Triple the Speed with Valkey - part 2",
            "url": "https://valkey.io/blog/unlock-one-million-rps-part2/",
            "by": "the Valkey project",
            "date": "2024-09-13",
            "checked": "2026-11-09"
          }
        }
      ],
      "edition": "2026-11"
    },
