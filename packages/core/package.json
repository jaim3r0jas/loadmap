{
  "name": "@loadmap/core",
  "version": "0.31.0",
  "description": "Capacity models in plain TypeScript: params, flows, components with capacities that say where they came from, limits, verdict, scenarios, growth and checks.",
  "keywords": [
    "loadmap",
    "capacity-planning",
    "model"
  ],
  "license": "MIT",
  "author": "Jaime Rojas",
  "homepage": "https://jaim3r0jas.github.io/loadmap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaim3r0jas/loadmap.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/jaim3r0jas/loadmap/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./calibrate": "./src/calibrate.ts",
    "./catalog": "./src/catalog.ts",
    "./drift": "./src/drift.ts",
    "./format": "./src/format.ts",
    "./measure": "./src/measure.ts",
    "./internal": "./src/internal.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./calibrate": {
        "types": "./dist/calibrate.d.ts",
        "import": "./dist/calibrate.js"
      },
      "./catalog": {
        "types": "./dist/catalog.d.ts",
        "import": "./dist/catalog.js"
      },
      "./drift": {
        "types": "./dist/drift.d.ts",
        "import": "./dist/drift.js"
      },
      "./format": {
        "types": "./dist/format.d.ts",
        "import": "./dist/format.js"
      },
      "./measure": {
        "types": "./dist/measure.d.ts",
        "import": "./dist/measure.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {},
  "peerDependencies": {}
}
