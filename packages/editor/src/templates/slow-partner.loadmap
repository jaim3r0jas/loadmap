loadmap 1.6
# A service that calls a partner's API on every request. The partner slows down as it fills: past the client's
# timeout a request fails and is sent again, which adds load just when the partner is slowest.
title: "Slow partner API"
view { speed: 10 }
assume: "1× is today's busiest minute; each stage's time is a single queue's, an estimate of its shape."

load "Requests, × today" { max: 10; default: 1 }

param timeout "Client timeout (s)" { options: [0.5, 1, 2]; default: 1 }
param retries "Retries" { options: [0, 2]; default: 2 }

scenario "Today" {}
scenario "No retries" { retries: 0 }
growth { rate: 0.05; per: month; asOf: "2026-11-01" }

expect "Requests answer in 400 ms today" { flow: requests; p99: 400ms; underTarget: 1 }

flow requests "requests" {
  unit: "request"
  rate: 200 * load
  timeout: timeout
  retry { times: retries }
  route: api -> partner
  from: clients
  color: accent
}

node clients "Clients"

node api "API" {
  pass
  short: "the API"
  service: 5ms
  capacity: measured(2_000, "req/s", "a load test")
  over: "requests queue in the API"
}

node partner "Partner API" {
  pass
  short: "the partner"
  service: 20ms
  capacity: estimated(400 +- 20%, "req/s", "the partner's published limit")
  over: "the partner answers 503s"
}

node timedOut "Timed out" { lost { takes: [timedOut] } }

clients -> api
api -> partner
partner -> timedOut
