{
  "name": "@loadmap/cli",
  "version": "0.19.0",
  "description": "loadmap check (capacity expectations in CI) and loadmap record (GIF, video, PNG or SVG of a page or a .loadmap file).",
  "keywords": [
    "loadmap",
    "cli",
    "ci",
    "capacity-planning"
  ],
  "license": "MIT",
  "author": "Jaime Rojas",
  "homepage": "https://jaim3r0jas.github.io/loadmap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaim3r0jas/loadmap.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/jaim3r0jas/loadmap/issues",
  "type": "module",
  "bin": {
    "loadmap": "./dist/bin.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && vite build --config viewer/vite.config.ts"
  },
  "dependencies": {
    "elkjs": "^0.12.1"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@loadmap/dsl": "workspace:*",
    "@loadmap/export": "workspace:*",
    "@loadmap/react": "workspace:*",
    "mediabunny": "1.65.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
