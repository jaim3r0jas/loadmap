{
  "name": "@loadmap/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "loadmap": "./dist/bin.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && vite build --config viewer/vite.config.ts"
  },
  "dependencies": {
    "elkjs": "0.12.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@loadmap/dsl": "workspace:*",
    "@loadmap/export": "workspace:*",
    "@loadmap/react": "workspace:*",
    "mediabunny": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
