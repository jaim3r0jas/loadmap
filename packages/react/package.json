{
  "name": "@loadmap/react",
  "version": "0.15.0",
  "description": "Interactive capacity models for React: an architecture diagram with moving dots, the limits ranked, the verdict, scenarios and headroom.",
  "keywords": [
    "loadmap",
    "react",
    "capacity-planning",
    "diagram",
    "architecture"
  ],
  "license": "MIT",
  "author": "Jaime Rojas",
  "homepage": "https://jaim3r0jas.github.io/loadmap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaim3r0jas/loadmap.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/jaim3r0jas/loadmap/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./source": "./src/source.tsx",
    "./elk.worker.js": "./src/elk.worker.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./source": {
        "types": "./dist/source.d.ts",
        "import": "./dist/source.js"
      },
      "./elk.worker.js": "./dist/elk.worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@loadmap/core": "workspace:*",
    "@loadmap/dsl": "workspace:*",
    "@loadmap/sim": "workspace:*",
    "@loadmap/layout": "workspace:*",
    "elkjs": "^0.12.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
