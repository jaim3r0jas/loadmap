{
  "name": "@loadmap/vscode",
  "private": true,
  "version": "0.0.0",
  "displayName": "loadmap",
  "description": "Capacity models in .loadmap: a live preview of the diagram beside the text, highlighting, errors and failing expectations as you type, completion, hover with the values, quick fixes, rename and formatting.",
  "publisher": "jaim3r0jas",
  "license": "MIT",
  "author": "Jaime Rojas",
  "homepage": "https://jaim3r0jas.github.io/loadmap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaim3r0jas/loadmap.git",
    "directory": "packages/vscode"
  },
  "bugs": "https://github.com/jaim3r0jas/loadmap/issues",
  "icon": "icons/loadmap.png",
  "galleryBanner": {
    "color": "#0d141b",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "loadmap",
    "capacity planning",
    "capacity model",
    "language server"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:loadmap",
    "onWebviewPanel:loadmap.preview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you have not trusted, the language server is always the one that comes with the extension, and share links always open the docs' own editor.",
      "restrictedConfigurations": [
        "loadmap.server.path",
        "loadmap.editorUrl"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "loadmap",
        "aliases": [
          "loadmap"
        ],
        "extensions": [
          ".loadmap"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-light.svg",
          "dark": "./icons/file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "loadmap",
        "scopeName": "source.loadmap",
        "path": "./syntaxes/loadmap.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "loadmap.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "loadmap",
        "icon": "$(open-preview)"
      },
      {
        "command": "loadmap.showPreview",
        "title": "Open Preview",
        "category": "loadmap",
        "icon": "$(open-preview)"
      },
      {
        "command": "loadmap.copyShareLink",
        "title": "Copy Share Link",
        "category": "loadmap",
        "icon": "$(link)"
      },
      {
        "command": "loadmap.openInEditor",
        "title": "Open in the Live Editor",
        "category": "loadmap",
        "icon": "$(link-external)"
      },
      {
        "command": "loadmap.restartServer",
        "title": "Restart the Language Server",
        "category": "loadmap"
      }
    ],
    "configurationDefaults": {
      "[loadmap]": {
        "editor.unicodeHighlight.ambiguousCharacters": false
      }
    },
    "configuration": {
      "title": "loadmap",
      "properties": {
        "loadmap.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "A `loadmap` command to run as the language server (`loadmap lsp`) instead of the one that comes with the extension, such as `node_modules/.bin/loadmap` for the version a project's CI checks with. A bare name (`loadmap`) is looked up on the `PATH`, a relative path starts at the first workspace folder. Empty: the extension's own. In a workspace you have not trusted, the extension's own always runs."
        },
        "loadmap.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server in the loadmap output."
        },
        "loadmap.editorUrl": {
          "type": "string",
          "default": "https://jaim3r0jas.github.io/loadmap/editor/",
          "markdownDescription": "The live editor a share link opens (an `http` or `https` link): the docs' own, or a copy of the docs site hosted elsewhere. The text travels in the link's `#`, which never reaches the server. A workspace you have not trusted cannot change it."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "loadmap.showPreviewToSide",
          "when": "editorLangId == loadmap",
          "group": "navigation"
        },
        {
          "command": "loadmap.copyShareLink",
          "when": "activeWebviewPanelId == 'loadmap.preview'",
          "group": "navigation@1"
        },
        {
          "command": "loadmap.openInEditor",
          "when": "activeWebviewPanelId == 'loadmap.preview'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "loadmap.showPreviewToSide",
          "when": "editorLangId == loadmap"
        },
        {
          "command": "loadmap.showPreview",
          "when": "editorLangId == loadmap"
        },
        {
          "command": "loadmap.copyShareLink",
          "when": "editorLangId == loadmap || activeWebviewPanelId == 'loadmap.preview'"
        },
        {
          "command": "loadmap.openInEditor",
          "when": "editorLangId == loadmap || activeWebviewPanelId == 'loadmap.preview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "loadmap.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == loadmap"
      },
      {
        "command": "loadmap.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == loadmap"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && vite build -c vite.webview.config.ts",
    "package": "node scripts/stage.ts",
    "test:e2e": "pnpm run build && node scripts/stage.ts --folder && tsdown -c tsdown.e2e.config.ts && node test/e2e/run.ts"
  },
  "devDependencies": {
    "@loadmap/cli": "workspace:*",
    "@loadmap/dsl": "workspace:*",
    "@loadmap/react": "workspace:*",
    "@types/vscode": "1.91.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.4",
    "vite": "8.3.5",
    "vscode-languageclient": "11.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
