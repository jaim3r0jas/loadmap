loadmap 1.8
include "./regions.story.loadmap"
import "./region.loadmap" { region }
# Two regions, each sized for its own users, and what happens to one when the other is lost. The regions are one
# subsystem of a library, each with its own sizes; the line that takes orders is a subsystem in it, from another.
title: "Two regions"
view { speed: 10; transition: 0.8; closed: [eu, us] }
assume: "1× is the busiest hour of an ordinary week, in both regions at once."
assume: "A region that is lost sends every order to the other one, at once."

load "Users, × today" { max: 10; default: 1 }

param euLost "Lose the EU region" { default: false }
param usLost "Lose the US region" { default: false }
param usPods "US order workers (pods)" { options: [2, 3, 4]; default: 2 }

scenario "Today" {}
scenario "EU lost" { euLost: true }
scenario "US lost" { usLost: true }
scenario "EU lost, four US pods" { euLost: true; usPods: 4 }

expect "Today keeps 2×" { underTarget: 2 }
expect "With the US lost, the EU keeps 1.5×" { scenario: "US lost"; underTarget: 1.5 }
expect "With the EU lost and four US pods, the US keeps 1.5×" { scenario: "EU lost, four US pods"; underTarget: 1.5 }

flow eu "EU orders" { rate: euLost ? 0 : 300 * load; route: router -> eu; from: users; color: accent }
flow euInUs "EU orders in the US" { rate: euLost ? 300 * load : 0; route: router -> us; from: users; color: accent }
flow us "US orders" { rate: usLost ? 0 : 200 * load; route: router -> us; from: users; color: alt }
flow usInEu "US orders in the EU" { rate: usLost ? 200 * load : 0; route: router -> eu; from: users; color: alt }

node users "Users" "EU and US"
node router "Traffic router" "by region" {
  pass
  short: "the traffic router"
  capacity: estimated(50_000, "req/s", "vendor sizing guide")
  over: "users get timeouts"
}

subsystem eu "EU region" { like: region; with { main: eu; spill: usInEu; pods: 4; apiPods: 10; dbLimit: 6_000 } }
subsystem us "US region" { like: region; with { main: us; spill: euInUs; pods: usPods; apiPods: 8 } }

users -> router
router -> eu
router -> us
