loadmap 1.6
library "Alerts platform"
# The pod every pool of the team runs on: its CPU limit is the capacity; how many, how big and what they must handle
# is each pool's to say.
pool podPool "Workers" {
  input pods
  input cores = 1
  input need
  pods: pods
  perPod: 8
  demand: need
  capacity: measured(pods * cores, "cores", "pod CPU limit")
}
