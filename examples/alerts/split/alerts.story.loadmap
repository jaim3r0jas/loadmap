loadmap 1.6
part of "./alerts.loadmap"

step "An ordinary peak: the position consumer is already past the 50 % target, and runs out first." {
  title: "Today at 10×"
}
step "At 25×, the position consumer is past 100 %: positions wait in their topic, and only the newest per user is "
     "kept." {
  load: 25
  focus: positionConsumer
}
step "Launch week runs eight position pods and four alert pods: the consumer is back under 100 %." {
  load: 25
  posPods: 8
  alertPods: 4
  title: "Launch week: more pods"
}
step "Pushing every position to every receiver, not only to the users watching, more than triples what the push "
     "broker sends: it runs out first now." {
  load: 25
  posPods: 8
  alertPods: 4
  watchOnly: false
  focus: push
  title: "Push to every receiver"
}
