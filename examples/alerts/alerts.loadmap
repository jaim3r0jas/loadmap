loadmap 1
# Alerts and positions: two flows on two topics that share three brokers, a pool of pods each, and a push broker
# that fans out to the people who receive them. Made-up names and numbers; the same model and view as model.ts and
# view.ts.
title: "Alerts and live positions"
speed: 10
transition: 1
fullScreen: [verdict, live, limits, controls, headroom]
fullScreenMode: panels
assume: "Load scales linearly with users; 1× is the busiest five minutes of an ordinary week."
assume: "Alerts come first at every hop: their own topic, their own pods, served before positions."

load "Users, × today" { max: 100; default: 10 }

param alertPods "Alert pipeline pods (8 threads each)" { options: [2, 3, 4, 6, 8]; default: 3 }
param posPods "Position consumer pods (16 threads each)" { options: [2, 3, 4, 6, 8]; default: 3 }
param pushNodes "Push broker nodes" { options: [2, 3, 4, 6]; default: 3 }
param merge "Keep only the newest position per user" {
  hint: "under backlog a batch saves only the newest fix of each user"
  default: true
}
param watchOnly "Push positions only to users watching" {
  hint: "instead of to every receiver"
  default: true
}

preset "Launch week" { load: 25; posPods: 8; alertPods: 4 }

# the walk Play takes: the whole diagram, a close-up on what each step changes, the change, the whole again
step "An ordinary peak: the position consumer is already past the 50 % target, and runs out first." {
  title: "Today at 10×"
}
step "At 25×, the position consumer is past 100 %: positions wait in their topic, and only the newest per user is kept." {
  load: 25
  focus: posPods
}
step "Launch week runs eight position pods and four alert pods: the consumer is back under 100 %." {
  load: 25
  posPods: 8
  alertPods: 4
  title: "Launch week: more pods"
}
step "Pushing every position to every receiver, not only to the users watching, more than triples what the push broker sends: it runs out first now." {
  load: 25
  posPods: 8
  alertPods: 4
  watchOnly: false
  focus: push
  title: "Push to every receiver"
}

# push packets per position: to watchers only, or to every receiver
let perPosition = watchOnly ? 0.3 : 1.2

# a synthetic series: 0.15 cores + 4 ms per alert, ±4 % noise
fit alertCores "Alert pipeline CPU per alert" {
  source: "synthetic series"
  points rate cores {
    10 0.1923
    30 0.2787
    50 0.3443
    70 0.4164
    90 0.4989
    110 0.6022
    130 0.6536
    150 0.7396
    170 0.8501
    190 0.8983
    210 0.9994
    230 1.0994
    250 1.1917
    270 1.2319
    290 1.2888
    310 1.3848
    330 1.4635
    350 1.5604
    370 1.5983
    390 1.7527
  }
}

flow alerts "alerts" {
  unit: "alert"
  rate: 12 * load
  priority: 1
  route: gateway -> alertTopic -> alertPods -> push
  from: phones
  color: alt
}

flow positions "positions" {
  unit: "position"
  rate: 260 * load
  priority: 2
  merge { when: merge; share: 0.37; reason: "newest kept" }
  route: gateway -> posTopic -> posPods -> push
  from: phones
  color: accent
}

tier edge "Edge"
tier processing "Processing"
tier delivery "Delivery"

node phones "Devices" "alerts and positions"

node gateway "Gateway" {
  tier: edge
  pass "the gateway"
  short: "the gateway"
  demand: flows.alerts + flows.positions
  capacity: estimated(30_000, "req/s", "load test pending")
  over: "phones get timeouts, alerts and positions alike"
}

cluster brokers "Brokers" "two topics, three brokers" {
  tier: processing
  members: 3
  memberLabel: `broker ${i}`
  queue alertTopic "alerts topic" { partitions { alerts: alertPods * 8 } }
  queue posTopic "positions topic" { partitions { positions: posPods * 16 } }
  short: "the brokers"
  plural: true
  demand: (flows.alerts * 1.5 + flows.positions * 1.0) / 1000
  capacity: estimated(20, "MB/s", "vendor sizing guide")
  over: "produce latency grows on both topics"
  describe: "3 brokers, both topics"
}

pool alertPods "Alert pipeline" `${alertPods} pods × 8 · high priority` {
  workers "alert pipeline" { pods: alertPods; perPod: 8 }
  short: "the alert pipeline"
  demand: alertCores(flows.alerts)
  capacity: measured(alertPods * 1, "cores", "pod CPU limit")
  over: "alerts wait in their topic: the one lag that pages"
  describe: `${alertPods} pods × 8 threads, 1 core each`
}

pool posPods "Position consumer" `${posPods} pods × 16` {
  workers "position consumer" { pods: posPods; perPod: 16 }
  short: "the position consumer"
  demand: flows.positions * 0.0015
  capacity: measured(posPods * 2, "cores", "pod CPU limit")
  over: "positions wait in their topic; under backlog only the newest per user is kept"
  describe: `${posPods} pods × 16 threads, 1.5 ms a position`
}

node db "State store" "primary" {
  shape: cylinder
  short: "the state store"
  demand: flows.alerts * 2
  capacity: estimated(2000, "writes/s")
  over: "state writes queue on the primary"
}

node push "Push broker" `${pushNodes} nodes` {
  tier: delivery
  fanout "push broker" {
    alerts -> contacts: 1
    alerts -> responders: 0.4
    positions -> watchers: perPosition
  }
  short: "the push broker"
  demand: flows.alerts * 1.4 + flows.positions * perPosition
  capacity: estimated(pushNodes * 4000, "packets/s", "about 4,000 packets/s per node")
  over: "pushes queue on the broker, so positions and alert updates arrive late"
}

node contacts "Contacts" "notified" { sink "contacts" }
node responders "Responders" "on duty" { sink "responders" }
node watchers "Watchers" "following live" { sink "watchers" }

phones -> gateway: "POST /events"
gateway -> brokers: `${compact(flows.positions)} positions/s`
brokers -> alertPods
brokers -> posPods
alertPods -> db: "state writes"
alertPods -> push
posPods -> push: merge ? "newest per user" : "every fix"
push -> contacts
push -> responders
push -> watchers: watchOnly ? "watchers only" : "every receiver"
