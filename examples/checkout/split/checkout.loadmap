loadmap 1.8
include "./checkout.data.loadmap"
include "./checkout.story.loadmap"
import "./platform.loadmap" { podPool; postgres }
# The checkout pipeline in several files: the same model and view as ../model.ts and ../view.ts, as ../checkout.loadmap
# is in one. The measured data and the story are parts; the worker pod and the database come from a library.
title: "Checkout pipeline"
view {
  speed: 10
  # full screen opens on the diagram and the story
  fullScreenMode: focus
  transition: 0.8
  layout: compact
}
assume: "Load scales linearly with users; 1× is the 5-minute peak of an ordinary day."

load "Users, × today" { max: 100; default: 10 }

param gateways "Gateway instances" { options: [1, 2]; default: 1 }
param pods "Worker pods" { options: [2, 3, 4, 6]; default: 3 }
param threads "Threads per pod" { options: [4, 8, 16]; default: 8 }
param batch "Batch DB writes" { default: true }
param rows "Rows per batch" { options: [10, 50]; default: 50; enabled: batch }

preset "Black Friday" { load: 40; pods: 6 }

# the design review: today against twice the gateways and the workers
scenario "Today" {}
scenario "Proposed" { gateways: 2; pods: 6 }
growth { rate: 0.06; per: month; asOf: "2026-11-01" }

# a change that loses headroom fails `loadmap check checkout.loadmap`
expect "Today keeps 7×" { underTarget: 7 }
expect "Proposed keeps 14×" { scenario: Proposed; underTarget: 14 }

flow orders "orders" {
  unit: "order"
  rate: 40 * load
  priority: 1
  route: gateway -> topic -> workerPool -> db
  from: phones
  color: accent
}

flow events "events" {
  unit: "event"
  rate: 900 * load
  priority: 2
  drop { olderThan: 60; reason: "too_old" }
  route: gateway -> topic -> workerPool
  from: phones
  color: alt
}

tier edge "Edge"
tier services "Services"
tier data "Data"

node phones "Phones" "app checkout"

node gateway "API gateway" {
  tier: edge
  pass
  short: "the API gateway"
  demand: flows.orders + flows.events
  capacity: estimated(20_000 * gateways +- 30%, "req/s", "vendor benchmark, not load-tested")
  over: "clients get 429s"
}

cluster kafka "Kafka" "orders and events" {
  tier: services
  members: 3
  memberLabel: `broker ${i}`
  queue topic { partitions { orders: 12; events: 24 } }
}
node kafkaDropped "Too old" { lost { takes: [dropped] } }

pool workerPool "Workers" `${pods} pods × ${threads} threads` {
  like: podPool
  with {
    pods: pods
    threads: threads
    cores: 2
    need: workerCores(flows.orders + flows.events)
  }
  name: "Worker pool"
  short: "the worker pool"
  over: "messages wait in the topic and the lag keeps growing"
}

node db "Postgres" "primary" {
  like: postgres
  with { writes: batch ? flows.orders / rows : flows.orders }
  tier: data
  name: "Postgres primary"
}

component conns "Postgres connections" {
  on: db
  held: 20ms
  capacity: configured(200, "connections", "pool size")
  over: "orders wait for a connection"
  describe: "each order holds one for 20 ms"
}

phones -> gateway: "POST /checkout"
gateway -> kafka: `${compact(flows.orders)} orders/s`
kafka -> workerPool
kafka -> kafkaDropped
workerPool -> db: batch ? `${rows} rows a commit` : "a commit per order"
