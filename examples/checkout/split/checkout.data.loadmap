loadmap 1.8
part of "./checkout.loadmap"
# The measured series behind the worker's cost: data beside the system, not in its way.

# cost = a + b × rate, fitted from the measured series
fit workerCores "Worker CPU per request" {
  source: "Grafana, peak week"
  points rate cores {
    200 0.2599
    350 0.3061
    500 0.3419
    650 0.3889
    800 0.4385
    950 0.4852
    1100 0.5166
    1250 0.5881
    1400 0.6233
    1550 0.6614
    1700 0.7008
    1850 0.7677
    2000 0.8076
    2150 0.8235
    2300 0.8899
    2450 0.9201
    2600 0.9901
    2750 1.004
    2900 1.0739
    3050 1.1141
    3200 1.1375
  }
}
