{
  "name": "loadmap-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "node scripts/node-version.mjs && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/node-version.mjs && vitest run",
    "test:node": "node scripts/node-version.mjs && vitest run --project node",
    "test:browser": "node scripts/node-version.mjs && vitest run --project browser",
    "build": "node scripts/node-version.mjs && pnpm -r --filter './packages/*' build && pnpm --filter docs build",
    "check": "node scripts/node-version.mjs && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budget",
    "dev": "node scripts/node-version.mjs && pnpm --filter docs dev",
    "record": "node scripts/node-version.mjs && pnpm --filter @loadmap/cli build > /dev/null && node packages/cli/dist/bin.js record",
    "budget": "node scripts/node-version.mjs && node scripts/budget.mjs",
    "changeset": "changeset",
    "verify:pack": "node scripts/node-version.mjs && node scripts/verify-pack.mjs",
    "release": "node scripts/node-version.mjs && pnpm check && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@loadmap/core": "workspace:*",
    "@loadmap/dsl": "workspace:*",
    "@loadmap/editor": "workspace:*",
    "@loadmap/layout": "workspace:*",
    "@loadmap/react": "workspace:*",
    "@loadmap/sim": "workspace:*",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
